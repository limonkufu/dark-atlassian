{
  "manifest_version": 3,
  "name": "Catppuccin Mocha for SKAO Atlassian",
  "version": "1.0.2",
  "description": "Catppuccin Mocha theme for confluence.skatelescope.org and jira.skatelescope.org, with an optional night-time schedule.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://confluence.skatelescope.org/*",
    "https://jira.skatelescope.org/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Catppuccin Mocha",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-theme": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Toggle Catppuccin Mocha (until the next scheduled change)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://confluence.skatelescope.org/*",
        "https://jira.skatelescope.org/*"
      ],
      "js": ["src/schedule.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*.css"],
      "matches": [
        "https://confluence.skatelescope.org/*",
        "https://jira.skatelescope.org/*"
      ]
    }
  ]
}
